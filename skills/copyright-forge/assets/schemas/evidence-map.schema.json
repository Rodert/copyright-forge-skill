{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "project", "features"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "project": {"type": "string"},
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "claim_status", "confidence", "evidence"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "claim_status": {"enum": ["candidate", "approved"]},
          "confidence": {"enum": ["low", "medium", "high"]},
          "evidence": {"type": "array", "minItems": 1}
        }
      }
    }
  }
}
