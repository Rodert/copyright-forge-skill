{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["project", "files", "total_lines"],
  "properties": {
    "project": {"type": "string"},
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "lines"],
        "properties": {
          "path": {"type": "string"},
          "lines": {"type": "integer", "minimum": 0}
        }
      }
    },
    "total_lines": {"type": "integer", "minimum": 0}
  }
}
